ase":{"w":"hase","p":"noun","g":"f","art":"l'","pl":"hases","plArt":"les","ipa":"/az/","gl":"a female rabbit or hare","ety":{"chain":[{"l":"de","f":"Hase","t":"der"},{"l":"gmh","f":"hase","t":"der"},{"l":"goh","f":"haso","t":"der"},{"l":"gem-pro","f":"*hesô","t":"der","g":"hare"}],"text":"From German Hase, from Middle High German hase, from Old High German haso, from Proto-Germanic *hesô (“hare”). More at hare."}},"it:lepre femmina":{"w":"lepre femmina"},"pt:lebre":{"w":"lebre","p":"noun","g":"f","art":"a","pl":"lebres","plArt":"as","ipaBR":"/ˈlɛ.bɾi/","ipa":"/ˈlɛ.bɾi/","ipaPT":"/ˈlɛ.bɾɨ/","gl":"hare","ety":{"chain":[{"l":"roa-opt","f":"lebre","t":"inh"},{"l":"la","f":"leporem","t":"inh","lm":"lepus","g":"a hare"}],"text":"Inherited from Old Galician-Portuguese lebre, from Latin leporem."}},"it:scoiattolo femmina":{"w":"scoiattolo femmina"},"es:ardilla":{"w":"ardilla","p":"noun","g":"f","art":"la","pl":"ardillas","plArt":"las","ipa":"/aɾˈdiʝa/","gl":"squirrel","ety":{"chain":[{"l":"es-ear","f":">>>","t":"inh","g":"squirrel"}],"text":"Inherited from Early Modern Spanish (h)ardilla, from (h)arda (“squirrel”) + -illa (diminutive suffix)."}}},"phr":["blue doe","doe-eyed","doe eyes","doelike","doeling","doe party","doeskin","doey"]}}