ry parson.","tags":["countable","obsolete","slang","uncountable"],"ex":["No company comes / But a rabble of tenants, and rusty dull rums."]}],"forms":[["pl","rums"]]},{"p":"adj","e":1,"senses":[{"d":"Fine, excellent, valuable.","tags":["obsolete"],"ex":["having a rum time"],"syn":["exceptional"]},{"d":"Strange, peculiar.","tags":["British","dated","informal"],"ex":["a rum idea; a rum fellow","\"Lor, Noah!\" said Charlotte, \"What a rum creature you are! Why don't you let the boy alone?\""],"syn":["bizarre"]}],"forms":[["comp","rummer"],["sup","rummest"]]},{"p":"noun","e":1,"senses":[{"d":"Any odd person or thing.","tags":["British","colloquial","dated"]}],"forms":[["pl","rums"]]},{"p":"noun","e":2,"senses":[{"d":"The card game rummy.","tags":["rare"]}]}],"grp":[{"label":"distilled spirit","zh":["蘭姆酒","萊姆酒","朗姆酒"],"p":"noun","e":0,"tr":{"fr":["fr:rhum"],"it":["it:rum"],"es":["es:ron","es:romo"],"pt":["pt:rum"]}}],"lx":{"fr:rhum":{"w":"rhum","p":"noun","g":"m","art":"le","pl":"rhums","plArt":"les","ipa":"/ʁɔm/","gl":"rum","ety":{"chain":[{"l":"en","f":"rum","t":"bor"}],"text":"Borrowed from English rum."}},"it:rum":{"w":"rum","p":"noun","g":"m","art":"il","ipa":"/ˈrum/","gl":"rum (distilled spirit)","ety":{"chain":[{"l":"en","f":"rum","t":"bor"}],"text":"Unadapted borrowing from English rum."}},"es:ron":{"w":"ron","p":"noun","g":"m","art":"el","pl":"rones","plArt":"los","ipa":"/ˈron/","gl":"rum","ety":{"chain":[{"l":"en","f":"rum","t":"bor"}],"text":"Borrowed from English rum."}},"es:romo":{"w":"romo","p":"noun","g":"m","art":"el","pl":"romos","plArt":"los","ipa":"/ˈromo/","gl":"rum","ety":{"chain":[{"l":"en","f":"rum","t":"der"}],"text":"A loanblend from the English rum, absorbed into the Spanish lexicon unique to Belize."}},"pt:rum":{"w":"rum","p":"noun","g":"m","art":"o","pl":"runs","plArt":"os","ipaBR":"/ˈʁũ/","ipa":"/ˈʁũ/","ipaPT":"/ˈʁũ/","gl":"rum","ety":{"chain":[{"l":"en","f":"rum","t":"bor"}],"text":"Borrowed from English rum."}}},"syn":["rumbullion","rumbustion","kill-devil","Nelson's blood","strange fish","weirdo","deviant","outlier","pukka","top-notch"],"phr":["antirum","rumbud","rumdriver","rumhound","rumly","rummery","rummish","rumpot","rumrunner","rumrunning","rumseller","rumshop"]}}