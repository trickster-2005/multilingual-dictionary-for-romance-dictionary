{"nah":{"w":"nah","zh":[],"ipa":{"uk":"[næː]","us":"[næː]"},"ety":[{"n":1,"chain":[],"text":"Colloquial/unarticulated form of no + -uh. Compare yeah = yes + -uh.","form":{"l":"en","parts":["no","uh"]}},{"n":2,"chain":[{"l":"ms","f":"nah","t":"bor"}],"text":"Borrowed from Malay nah. Unrelated to nah mean."}],"pos":[{"p":"intj","e":0,"senses":[{"d":"No.","tags":["informal"],"ex":["Nah, I'd win."],"syn":["naw"],"grp":0}]},{"p":"intj","e":1,"senses":[{"d":"here! (when giving something).","ex":["Nah, take this."]}]}],"grp":[{"label":"no","zh":[],"p":"intj","e":0,"tr":{"fr":["fr:nan"],"it":[],"es":["es:nah"],"pt":["pt:nem|BR","pt:ná","pt:nã"]}}],"lx":{"fr:nan":{"w":"nan"},"es:nah":{"w":"nah"},"pt:nem|BR":{"w":"nem","v":"BR","p":"intj","ipaBR":"/ˈnẽj̃/","ipa":"/ˈnẽj̃/","ipaPT":"/ˈnɐ̃j̃/","gl":"nah, no","ety":{"chain":[{"l":"roa-opt","f":"nen","t":"inh"},{"l":"la","f":"nec","t":"der","g":"nor; and not"},{"l":"la","f":"neque","t":"der","g":"not"},{"l":"ine-pro","f":"*nékʷe","t":"der","g":"and not, neither, nor"}],"text":"From Old Galician-Portuguese nen, from Latin nec (“nor; and not”). Compare Galician nin, Catalan, French, and Spanish ni, Italian né."}},"pt:ná":{"w":"ná"},"pt:nã":{"w":"nã"}}}}