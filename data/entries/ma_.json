{"ma":{"w":"ma","zh":[],"ipa":{"uk":"/mɑː/","us":"/mɑː/"},"ety":[{"n":1,"chain":[],"text":"The sound, which parents interpret as a reference to themselves, is very commonly made by infants. For more on the linguistic process whereby infants' monosyllables are tied to ancient word roots for parents, see mama, papa, mātēr, and patēr."},{"n":2,"chain":[],"text":"Abbreviation."},{"n":3,"chain":[{"l":"ja","f":"間","t":"bor"}],"text":"Borrowed from Japanese 間."}],"pos":[{"p":"noun","e":0,"senses":[{"d":"mother, mama","tags":["colloquial"],"syn":["mama","mamma","mater","maw","mom","mommy"],"grp":0},{"d":"The landlady of a theater.","tags":["colloquial"],"ex":["[…] that dear little man writing in the guestbook of the \"Ma\" or theatrical landlady […]"]}],"forms":[["pl","mas"]]},{"p":"noun","e":1,"senses":[{"d":"May."}]},{"p":"noun","e":2,"senses":[{"d":"Negative space in Japanese art.","tags":["uncountable"]}]}],"grp":[{"label":"colloquial form of mother","zh":[],"p":"noun","e":0,"tr":{"fr":["fr:maman"],"it":["it:mamma"],"es":["es:mamá"],"pt":["pt:mamãe","pt:mamã"]}}],"lx":{"fr:maman":{"w":"maman","p":"noun","g":"f","art":"la","pl":"mamans","plArt":"les","ipa":"/ma.mɑ̃/","gl":"mummy, mommy, mom, mum","ety":{"chain":[{"l":"frm","f":"memmen","t":"inh"},{"l":"la","f":"mamma","t":"der","g":"breast"},{"l":"grc","f":"μάμμη","t":"bor","unc":true}],"text":"Inherited from Middle French memmen, from baby talk, possibly influenced by Latin mamma."}},"it:mamma":{"w":"mamma","p":"noun","g":"f","art":"la","pl":"mamme","plArt":"le","ipa":"/ˈmam.ma/","gl":"mom/mum","ety":{"chain":[{"l":"la","f":"mamma","t":"inh","g":"breast"},{"l":"grc","f":"μάμμη","t":"bor","unc":true}],"text":"Inherited from Latin mamma."}},"es:mamá":{"w":"mamá","p":"noun","g":"f","art":"la","pl":"mamás","plArt":"las","ipa":"/maˈma/","gl":"mum, mom","ety":{"chain":[{"l":"fr","f":"maman","t":"bor","g":"mummy, mommy, mom, mum"},{"l":"frm","f":"memmen","t":"inh"},{"l":"la","f":"mamma","t":"der","g":"breast"},{"l":"grc","f":"