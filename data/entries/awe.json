":"noun","e":0,"senses":[{"d":"A person who is awesome.","tags":["countable","informal"],"ex":["“Or as I like to think of it, the wusses versus the awesomes.”"]}]}],"grp":[{"label":"causing awe or terror","zh":["令人敬畏的"],"p":"adj","e":0,"tr":{"fr":["fr:impressionnant","fr:terrifiant"],"it":["it:impressionante"],"es":["es:asombroso"],"pt":["pt:apavorante","pt:aterrador"]}},{"label":"excellent, exciting","zh":["厲害","了不起","牛逼","牛"],"p":"adj","e":0,"tr":{"fr":["fr:magnifique","fr:formidable","fr:épatant"],"it":["it:magnifico","it:splendido","it:fantastico"],"es":["es:piola","es:paja","es:mostro"],"pt":["pt:incrível"]}}],"lx":{"fr:impressionnant":{"w":"impressionnant","p":"adj","fem":"impressionnante","ipa":"/ɛ̃.pʁɛ.sjɔ.nɑ̃/","gl":"impressive","ety":{"chain":[]}},"fr:terrifiant":{"w":"terrifiant","p":"adj","fem":"terrifiante","ipa":"/tɛ.ʁi.fjɑ̃/","gl":"terrifying","ety":{"chain":[]}},"it:impressionante":{"w":"impressionante","p":"adj","pl":"impressionanti","ipa":"/im.pres.sjoˈnan.te/","gl":"striking, impressive, grand, stunning, shocking","ety":{"chain":[],"text":"From impressionare + -ante. Cognate with Asturian, Galician and Spanish impresionante.","form":{"l":"it","parts":["impressionare","ante"]}}},"es:asombroso":{"w":"asombroso","p":"adj","fem":"asombrosa","ipa":"/asomˈbɾoso/","gl":"amazing, wondrous, breathtaking, awesome (inspiring awe, wonder or admiration)","ety":{"chain":[],"text":"Spanish asombrardeverb. Spanish asombro Proto-Indo-European *h₃ed- Proto-Indo-European *-os Proto-Indo-European *h₃édosder.? Proto-Italic *-ŏ̄dsos? Old Latin -ōssus Latin -ōsus Old Spanish -oso Spanish -oso Spanish asombroso From asombro + -oso.","form":{"l":"es","parts":["asombro","-oso"]}}},"pt:apavorante":{"w":"apavorante","p":"adj","pl":"apavorantes","ipaBR":"/a.pa.voˈɾɐ̃.t͡ʃi/","ipa":"/a.pa.voˈɾɐ̃.t͡ʃi/","ipaPT":"/ɐ.pɐ.vuˈɾɐ̃.tɨ/","gl":"scary","ety":{"chain":[]}},"pt:aterrador":{"w":"aterrador","p":"adj","fem":"aterradora","ipaBR":"/a.te.ɾaˈdoʁ/","ipa":"/a.te.ɾaˈdoʁ/","ipaPT":"/ɐ