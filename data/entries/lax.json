{"lax":{"w":"lax","zh":[],"ipa":{"uk":"/læks/","us":"/læks/"},"ety":[{"n":1,"chain":[{"l":"enm","f":"lax","t":"inh"},{"l":"ang","f":"leax","t":"inh","g":"salmon"},{"l":"gmw-pro","f":"*lahs","t":"inh","g":"salmon"},{"l":"gem-pro","f":"*lahsaz","t":"inh","g":"salmon"},{"l":"ine-pro","f":"*laḱs-","t":"der","g":"salmon, trout"}],"text":"From Middle English lax, from Old English leax (“salmon”), from Proto-West Germanic *lahs (“salmon”), from Proto-Germanic *lahsaz (“salmon”), from Proto-Indo-European *laḱs- (“salmon, trout”). Cognate with Middle Dutch lacks, lachs, lasche (“salmon”), Middle Low German las (“salmon”), German Lachs (“salmon”), Norwegian laks (“salmon”), Danish laks (“salmon”), Swedish lax (“salmon”), Icelandic lax (“salmon”), Lithuanian lašišà (“salmon”), Latvian lasis, Russian лосо́сь (losósʹ, “salmon”), Albanian leshterik (“eel-grass”). Doublet of lox.","cog":[{"l":"dum","f":"lacks"},{"l":"gml","f":"las"},{"l":"de","f":"Lachs"},{"l":"no","f":"laks"},{"l":"da","f":"laks"},{"l":"sv","f":"lax"},{"l":"is","f":"lax"},{"l":"lt","f":"lašišà"}]},{"n":2,"chain":[{"l":"la","f":"laxus","t":"bor","g":"wide, roomy, loose"},{"l":"ine-pro","f":"*(s)leg-s-ós","t":"inh","lm":"*(s)leg-","g":"weak, faint; to slacken"}],"text":"Borrowed from Latin laxus (“wide, roomy, loose”)."},{"n":3,"chain":[],"text":"By replacement of the syllable crosse with the cross-shaped letter x."}],"pos":[{"p":"noun","e":0,"senses":[{"d":"A salmon.","tags":["Scotland","British"]}],"forms":[["pl","laxes"]]},{"p":"adj","e":1,"senses":[{"d":"Lenient and allowing for deviation; not strict.","ex":["The rules are fairly lax, but you have to know which ones you can bend.","Society at that epoch was lenient, if not lax, in matters of the passions."],"syn":["permissive","lenient","relaxed","clement","easygoing","forbearing"],"grp":0},{"d":"Loose; not tight or taut.","ex":["The rope fell lax."],"syn":["loose","slack"],"grp":1},{"d":"Lacking care; neglectful, negligent.","syn":["blameworthy","lash","negligent","remiss","reprehensible"],"grp":2},{"d":"Describing an associative monoidal functor.","tags":["mathematics"]},{"d":"Having a looseness of the bowels; diarrheic.","tags":["archaic"]},{"d":"(of a vowel) Produced with relatively little constriction of the vocal tract.","syn":["slack"]}],"forms":[["comp","laxer"],["sup","laxest"]]},{"p":"noun","e":2,"senses":[{"d":"lacrosse.","tags":["slang","uncountable"],"ex":["“I'm not playing lax this term,” Mimah said."]}]}],"grp":[{"label":"not strict; lenient; allowing for deviation","zh":[],"p":"adj","e":1,"tr":{"fr":["fr:laxiste"],"it":["it:lasso","it:lassista"],"es":["es:laxo"],"pt":["pt:leniente"]}},{"label":"loose; not tight or taut","zh":[],"p":"adj","e":1,"tr":{"fr":[],"it":["it:allentato","it:sciolto","it:lasso"],"es":[],"pt":["pt:frouxo"]}},{"label":"lacking care","zh":[],"p":"adj","e":1,"tr":{"fr":["fr:laxiste"],"it":["it:trascurato","it:negligente"],"es":[],"pt":["pt:negligente"]}}],"lx":{"fr:laxiste":{"w":"laxiste","p":"adj","pl":"laxistes","ipa":"/lak.sist/","gl":"lax","ety":{"chain":[],"text":"From Latin laxus (“loose”) + -iste.","form":{"l":"fr","parts":["la:laxus<t:loose>","-iste"]}}},"it:lasso":{"w":"lasso","p":"adj","fem":"lassa","ipa":"/ˈlas.so/","gl":"tired, weary, fatigued, weak","ety":{"chain":[{"l":"la","f":"lassus","t":"der","g":"weary, tired"},{"l":"ine-pro","f":"*lh₁d-to-s","t":"inh"}],"text":"From Latin lassus (“weary, tired”). For the interjection, compare French hélas, English alas."}},"it:lassista":{"w":"lassista","p":"adj","gl":"lax","ety":{"chain":[]}},"es:laxo":{"w":"laxo","p":"adj","fem":"laxa","ipa":"/ˈlaɡso/","gl":"lax","ety":{"chain":[{"l":"la","f":"laxus","t":"der","g":"wide, spacious, roomy"},{"l":"ine-pro","f":"*(s)leg-s-ós","t":"inh","lm":"*(s)leg-","g":"weak, faint; to slacken"}],"text":"From Latin laxus."}},"pt:leniente":{"w":"leniente","p":"adj","pl":"lenientes","ipaBR":"/le.niˈẽ.t͡ʃi/","ipa":"/le.niˈẽ.t͡ʃi/","ipaPT":"/lɨˈnjẽ.tɨ/","gl":"lenient; tolerant; permissive","ety":{"chain":[]}},"it:allentato":{"w":"allentato","p":"adj","fem":"allentata","gl":"loosened","ety":{"chain":[]}},"it:sciolto":{"w":"sciolto","p":"adj","fem":"sciolta","ipa":"/ˈʃɔl.to/","gl":"loose, untied","ety":{"chain":[{"l":"la-vul","f":"*exsoltus","t":"der"}],"text":"From sciogliere, or Vulgar Latin *exsoltus, from exsolūtus."}},"pt:frouxo":{"w":"frouxo","p":"adj","fem":"frouxa","ipaBR":"/ˈfɾo(w).ʃu/","ipa":"/ˈfɾo(w).ʃu/","ipaPT":"/ˈfɾo(w).ʃu/","gl":"loose, lax","ety":{"chain":[{"l":"la","f":"fluxus","t":"bor","g":"flowing, fluid"},{"l":"la","f":"fluō","t":"der","g":"to flow, stream, pour"},{"l":"ine-pro","f":"*bʰluH-yé-ti","t":"inh"},{"l":"ine-pro","f":"*bʰlewH-","t":"der"},{"l":"ine-pro","f":"*bʰel-","t":"der"}],"text":"Semi-learned borrowing from Latin fluxus. Doublet of chocho and fluxo."}},"it:trascurato":{"w":"trascurato","p":"adj","fem":"trascurata","ipa":"/tras.kuˈra.to/","gl":"slovenly","ety":{"chain":[],"text":"Past participle of trascurare."}},"it:negligente":{"w":"negligente","p":"adj","pl":"negligenti","ipa":"/ne.ɡliˈd͡ʒɛn.te/","gl":"negligent","ety":{"chain":[{"l":"la","f":"negligentem","t":"bor","lm":"negligens"}],"text":"Borrowed from Latin negligentem, variant of neglegens."}},"pt:negligente":{"w":"negligente","p":"adj","pl":"negligentes","ipaBR":"/ne.ɡliˈʒẽ.t͡ʃi/","ipa":"/ne.ɡliˈʒẽ.t͡ʃi/","ipaPT":"/nɨ.ɡliˈʒẽ.tɨ/","gl":"negligent (without appropriate or sufficient attention)","ety":{"chain":[{"l":"la","f":"negligentem","t":"bor","lm":"negligens"}],"text":"Borrowed from Latin negligentem, variant of neglegēns."}}},"phr":["laxative","laxed","laxing","laxism","laxist","laxly","laxness","lax up","lax vowel","overlax"]}}